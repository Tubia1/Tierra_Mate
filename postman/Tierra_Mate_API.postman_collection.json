{
  "info": {
    "_postman_id": "726bc2da-4cee-4f17-8eef-bfe1421b4299",
    "name": "Tierra Mate API",
    "description": "Colección para probar todos los endpoints implementados de Tierra Mate Shop. Iniciar la API, seleccionar el environment Tierra Mate Local, completar adminEmail y adminPassword, y ejecutar en el orden de la colección. Las escrituras requieren el token guardado por Login.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const expectedStatus = Number(pm.variables.get('expectedStatus'));",
          "pm.test(`Status ${expectedStatus}`, () => pm.response.to.have.status(expectedStatus));",
          "pm.test('Content-Type JSON', () => pm.expect(pm.response.headers.get('Content-Type') || '').to.include('application/json'));",
          "let body;",
          "pm.test('Respuesta JSON válida', () => { body = pm.response.json(); pm.expect(body).to.be.an('object'); });",
          "if (pm.response.code >= 200 && pm.response.code < 300) {",
          "  pm.test('La respuesta exitosa contiene data', () => pm.expect(body).to.have.property('data'));",
          "} else {",
          "  pm.test('La respuesta fallida contiene error.code', () => { pm.expect(body).to.have.nested.property('error.code'); });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "00 - Estado",
      "item": [
        {
          "name": "Raíz de la API",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{baseUrl}}/" },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        },
        {
          "name": "Estado de la API",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{baseUrl}}/api/health" },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        },
        {
          "name": "Estado de la base de datos",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{baseUrl}}/api/health/database" },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        }
      ]
    },
    {
      "name": "01 - Autenticación",
      "item": [
        {
          "name": "Login administrativo",
          "event": [{
            "listen": "test",
            "script": {
              "type": "text/javascript",
              "exec": [
                "const json = pm.response.json();",
                "pm.test('Existe data.token', () => pm.expect(json).to.have.nested.property('data.token').that.is.a('string').and.not.empty);",
                "pm.test('Existe data.admin', () => pm.expect(json).to.have.nested.property('data.admin').that.is.an('object'));",
                "pm.environment.set(\"token\", pm.response.json().data.token);"
              ]
            }
          }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        }
      ]
    },
    {
      "name": "02 - Categorías",
      "item": [
        {
          "name": "Listar categorías",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{baseUrl}}/api/categories" },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        },
        {
          "name": "Listar categorías activas",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{baseUrl}}/api/categories?active=true&limit=10" },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        },
        {
          "name": "Crear categoría",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "pm.test('Existe data.id', () => pm.expect(json).to.have.nested.property('data.id'));", "pm.environment.set('categoryId', json.data.id);"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Categoría de prueba Postman\",\n  \"display_order\": 10,\n  \"active\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/categories"
          },
          "variable": [{ "key": "expectedStatus", "value": "201" }]
        },
        {
          "name": "Obtener categoría",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{baseUrl}}/api/categories/{{categoryId}}" },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        },
        {
          "name": "Modificar categoría",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Categoría de prueba modificada\",\n  \"display_order\": 11\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/categories/{{categoryId}}"
          },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        },
        {
          "name": "Desactivar categoría (ejecutar al final)",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/categories/{{categoryId}}" },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        }
      ]
    },
    {
      "name": "03 - Productos",
      "item": [
        {
          "name": "Listar productos",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{baseUrl}}/api/products" },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        },
        {
          "name": "Listar productos por categoría",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{baseUrl}}/api/products?category_id={{categoryId}}&active=true" },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        },
        {
          "name": "Crear producto",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "pm.test('Existe data.id', () => pm.expect(json).to.have.nested.property('data.id'));", "pm.environment.set('productId', json.data.id);"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"category_id\": \"{{categoryId}}\",\n  \"name\": \"Mate Imperial de prueba\",\n  \"description\": \"Producto creado desde Postman\",\n  \"materials\": \"Calabaza, cuero y alpaca\",\n  \"featured\": true,\n  \"active\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/products"
          },
          "variable": [{ "key": "expectedStatus", "value": "201" }]
        },
        {
          "name": "Obtener producto completo",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{baseUrl}}/api/products/{{productId}}" },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        },
        {
          "name": "Modificar producto",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Mate Imperial Negro\",\n  \"description\": \"Producto modificado desde Postman\",\n  \"featured\": false\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/products/{{productId}}"
          },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        },
        {
          "name": "Desactivar producto (ejecutar al final)",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/products/{{productId}}" },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        }
      ]
    },
    {
      "name": "04 - Variantes y stock",
      "item": [
        {
          "name": "Crear variante",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "pm.test('Existe data.id', () => pm.expect(json).to.have.nested.property('data.id'));", "pm.environment.set('variantId', json.data.id);"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"sku\": \"MATE-POSTMAN-{{$timestamp}}\",\n  \"name\": \"Negro con alpaca\",\n  \"color\": \"Negro\",\n  \"finish\": \"Alpaca\",\n  \"price\": 35000,\n  \"stock_quantity\": 10,\n  \"low_stock_threshold\": 2,\n  \"active\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/products/{{productId}}/variants"
          },
          "variable": [{ "key": "expectedStatus", "value": "201" }]
        },
        {
          "name": "Modificar variante",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Negro premium\",\n  \"price\": 37500,\n  \"finish\": \"Alpaca grabada\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/products/{{productId}}/variants/{{variantId}}"
          },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        },
        {
          "name": "Ajustar stock",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"new_stock\": 15,\n  \"note\": \"Ingreso de mercadería desde Postman\"\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/products/{{productId}}/variants/{{variantId}}/stock"
          },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        },
        {
          "name": "Desactivar variante",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/products/{{productId}}/variants/{{variantId}}" },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        }
      ]
    },
    {
      "name": "05 - Imágenes",
      "item": [
        {
          "name": "Crear registro de imagen",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "pm.test('Existe data.id', () => pm.expect(json).to.have.nested.property('data.id'));", "pm.environment.set('imageId', json.data.id);"] } }],
          "request": {
            "description": "Registra la ruta y metadatos de la imagen. Este endpoint todavía no sube el archivo a Supabase Storage.",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"storage_path\": \"products/pruebas/mate-imperial.jpg\",\n  \"alt_text\": \"Mate imperial negro\",\n  \"is_primary\": true,\n  \"display_order\": 1\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/products/{{productId}}/images"
          },
          "variable": [{ "key": "expectedStatus", "value": "201" }]
        },
        {
          "name": "Modificar imagen",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"alt_text\": \"Mate imperial negro artesanal\",\n  \"display_order\": 2\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/products/{{productId}}/images/{{imageId}}"
          },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        },
        {
          "name": "Eliminar imagen",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/products/{{productId}}/images/{{imageId}}" },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        }
      ]
    },
    {
      "name": "06 - Personalizaciones",
      "item": [
        {
          "name": "Crear personalización",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["const json = pm.response.json();", "pm.test('Existe data.id', () => pm.expect(json).to.have.nested.property('data.id'));", "pm.environment.set('personalizationId', json.data.id);"] } }],
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Tipo de grabado\",\n  \"input_type\": \"select\",\n  \"choices\": [\n    {\n      \"value\": \"iniciales\",\n      \"label\": \"Iniciales\"\n    },\n    {\n      \"value\": \"nombre\",\n      \"label\": \"Nombre completo\"\n    }\n  ],\n  \"extra_price\": 3000,\n  \"required\": false,\n  \"allows_note\": true,\n  \"display_order\": 1,\n  \"active\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/products/{{productId}}/personalizations"
          },
          "variable": [{ "key": "expectedStatus", "value": "201" }]
        },
        {
          "name": "Modificar personalización",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"extra_price\": 3500,\n  \"required\": true\n}", "options": { "raw": { "language": "json" } } },
            "url": "{{baseUrl}}/api/products/{{productId}}/personalizations/{{personalizationId}}"
          },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        },
        {
          "name": "Desactivar personalización",
          "request": { "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] }, "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/products/{{productId}}/personalizations/{{personalizationId}}" },
          "variable": [{ "key": "expectedStatus", "value": "200" }]
        }
      ]
    }
  ]
}
