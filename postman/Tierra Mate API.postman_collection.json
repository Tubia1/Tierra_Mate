		{
			"name": "01 - Autenticación",
			"item": [
				{
					"name": "Login administrativo",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const json = pm.response.json();",
									"pm.test('Existe data.token', () => pm.expect(json).to.have.nested.property('data.token').that.is.a('string').and.not.empty);",
									"pm.test('Existe data.admin', () => pm.expect(json).to.have.nested.property('data.admin').that.is.an('object'));",
									"pm.environment.set(\"token\", pm.response.json().data.token);"
								]
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
